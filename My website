    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Interactive Fee Calculator Logic
        function calculateFee() {
            const scopeInputs = document.querySelectorAll('input[name="scope"]');
            let baseFee = 150000;

            scopeInputs.forEach(input => {
                if (input.checked) {
                    baseFee = parseInt(input.value);
                }
            });

            const branchOpt = document.getElementById('optBranch');
            const preAuditOpt = document.getElementById('optPreAudit');

            if (branchOpt && branchOpt.checked) baseFee += parseInt(branchOpt.value);
            if (preAuditOpt && preAuditOpt.checked) baseFee += parseInt(preAuditOpt.value);

            document.getElementById('calcResult').innerText = baseFee.toLocaleString('ru-RU') + ' ₸';
        }

        // Add Listeners to Calculator Inputs
        document.querySelectorAll('input[name="scope"], #optBranch, #optPreAudit').forEach(element => {
            element.addEventListener('change', calculateFee);
        });

        // Apply calculator output to contact form select
        function applyCalcToForm() {
            const selectedScope = document.querySelector('input[name="scope"]:checked');
            const formSelect = document.getElementById('formScopeSelect');
            
            if (selectedScope && formSelect) {
                const val = parseInt(selectedScope.value);
                if (val === 150000) formSelect.value = "До 10 методик";
                else if (val === 280000) formSelect.value = "11-30 методик";
                else if (val === 500000) formSelect.value = "31-70 методик";
                else formSelect.value = "Более 70 методик";
            }

            // Scroll to form smoothly
            document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
        }

        // Form Submit Simulation
        const auditForm = document.getElementById('auditForm');
        const successModal = document.getElementById('successModal');

        auditForm.addEventListener('submit', (e) => {
            e.preventDefault();
            successModal.classList.remove('hidden');
            successModal.classList.add('flex');
            auditForm.reset();
        });

        function closeModal() {
            successModal.classList.add('hidden');
            successModal.classList.remove('flex');
        }
    </script>
